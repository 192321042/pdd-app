{
  "name": "omniguard-appium-e2e",
  "version": "1.0.0",
  "description": "Enterprise Appium E2E Automation Framework for Android Application",
  "main": "index.js",
  "scripts": {
    "test": "npx mocha tests/*.test.js --timeout 300000 --reporter mochawesome --reporter-options reportDir=reports,reportFilename=index,html=true,json=true",
    "test:login": "npx mocha tests/login.test.js --timeout 300000",
    "test:form": "npx mocha tests/form.test.js --timeout 300000",
    "test:e2e": "npx mocha tests/e2e.test.js --timeout 300000"
  },
  "keywords": [
    "appium",
    "android",
    "e2e",
    "testing",
    "webdriverio",
    "mocha"
  ],
  "author": "QA Automation Architect",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "winston": "^3.12.0"
  },
  "devDependencies": {
    "appium": "^3.5.0",
    "appium-uiautomator2-driver": "^7.6.1",
    "chai": "^4.4.1",
    "mocha": "^10.3.0",
    "mochawesome": "^7.1.3",
    "mochawesome-report-generator": "^6.2.0",
    "webdriverio": "^8.32.4"
  }
}
